rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================
    // FUNCOES AUXILIARES
    // ==========================================================

    function isAuth() {
      return request.auth != null;
    }

    function authUid() {
      return request.auth.uid;
    }

    function authEmail() {
      return request.auth.token.email;
    }

    function getUserData() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isOwnUser(userId) {
      return isAuth() && authUid() == userId;
    }

    function isSuperAdmin() {
      return isAuth()
        && getUserData().get('role', '') == 'super_admin';
    }

    function isGymAdmin() {
      return isAuth()
        && getUserData().get('role', '') == 'gym_admin';
    }

    function isPersonal() {
      return isAuth()
        && (
          getUserData().get('role', '') == 'personal'
          || getUserData().get('role', '') == 'professor'
          || getUserData().get('tipo', '') == 'personal'
          || getUserData().get('isPersonal', false) == true
          || isSuperAdmin()
        );
    }

    function isLinkedPersonal(studentId) {
      return isAuth()
        && isPersonal()
        && exists(
          /databases/$(database)/documents/users/$(studentId)
        )
        && get(
          /databases/$(database)/documents/users/$(studentId)
        ).data.get('personalId', '') == authUid();
    }

    function isGymOwner(academiaId) {
      return isGymAdmin()
        && get(
          /databases/$(database)/documents/academias/$(academiaId)
        ).data.get('emailGestor', '') ==
          getUserData().get('email', '');
    }

    function chatExists(chatId) {
      return exists(
        /databases/$(database)/documents/chats/$(chatId)
      );
    }

    function isChatMember(chatId) {
      return isAuth()
        && chatExists(chatId)
        && get(
          /databases/$(database)/documents/chats/$(chatId)
        ).data.get('users', []).hasAny([authUid()]);
    }

    function isChallengeParticipant(challengeId) {
      return isAuth()
        && exists(
          /databases/$(database)/documents/challenges/$(challengeId)
        )
        && get(
          /databases/$(database)/documents/challenges/$(challengeId)
        ).data.get('participantIds', []).hasAny([authUid()]);
    }

    // ==========================================================
    // USERS
    // ==========================================================

    match /users/{userId} {

      // --------------------------------------------------------
      // NOTAS PRIVADAS DO PERSONAL
      // users/{studentId}/private_notes/{personalId}
      // --------------------------------------------------------

      match /private_notes/{personalId} {

        allow read: if isAuth()
          && personalId == authUid()
          && isLinkedPersonal(userId);

        allow create, update: if isAuth()
          && personalId == authUid()
          && isLinkedPersonal(userId)
          && request.resource.data.get(
            'personalId',
            ''
          ) == authUid();

        allow delete: if isAuth()
          && personalId == authUid()
          && isLinkedPersonal(userId);
      }

      /*
       * TRANSICAO:
       * O app ainda pesquisa usuarios por email e personalId.
       * Por isso a leitura continua disponivel para usuarios
       * autenticados ate separarmos public_profiles de users.
       */
      allow read: if isAuth();

      /*
       * Criacao do proprio perfil.
       *
       * O app cria "tipo" aluno/personal.
       * O Okan Web cria "role" gym_admin no cadastro da academia.
       */
      allow create: if isOwnUser(userId)
  && request.resource.data.get('uid', '') == userId
  && request.resource.data.get('email', '') == authEmail()
  && !request.resource.data.keys().hasAny([
    'isPremium',
    'subscriptionPlan',
    'subscriptionDate',
    'teacherNotes',
    'personalId',
    'personalName',
    'inviteFromPersonalId'
  ])
  && (
    (
      !('role' in request.resource.data)
      && (
        !('tipo' in request.resource.data)
        || request.resource.data.tipo in ['aluno', 'personal']
      )
    )
    ||
    (
      request.resource.data.get('role', '') == 'gym_admin'
      && !('tipo' in request.resource.data)
      && request.resource.data.get('academiaId', '') != ''
      && getAfter(
        /databases/$(database)/documents/academias/$(
          request.resource.data.academiaId
        )
      ).data.get('ownerUid', '') == userId
      && getAfter(
        /databases/$(database)/documents/academias/$(
          request.resource.data.academiaId
        )
      ).data.get('emailGestor', '') == authEmail()
    )
  );

        /*
       * O usuario pode editar o proprio perfil, mas nao pode
       * alterar campos de privilegio, pagamento ou administracao.
       */
      allow update: if isOwnUser(userId)
        && !request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasAny([
            'uid',
            'email',
            'role',
            'tipo',
            'isPersonal',
            'isPremium',
            'subscriptionPlan',
            'subscriptionDate',
            'academiaId',
            'teacherNotes'
          ]);

                /*
                * Um personal so pode alterar dados de acompanhamento
                * de um aluno realmente vinculado a ele.
                */
                /*
          * Personal vinculado pode encerrar o proprio vinculo com o aluno,
          * mas somente removendo os campos de relacionamento.
          */


        /*
          * Personal vinculado pode atualizar apenas dados
          * de acompanhamento do aluno.
          */
          // 1. Acompanhamento
            allow update: if isLinkedPersonal(userId)
              && request.resource.data
                .diff(resource.data)
                .affectedKeys()
                .hasOnly([
                  'peso',
                  'altura',
                  'bodyFatPercentage',
                  'imc',
                ]);

            // 2. Encerrar vínculo
            allow update: if isLinkedPersonal(userId)
              && request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly([
                  'personalId',
                  'personalName',
                  'inviteFromPersonalId'
                ])
              && !request.resource.data.keys().hasAny([
                'personalId',
                'personalName',
                'inviteFromPersonalId'
              ]);

      /*
       * Super admin pode administrar usuarios.
       */
      allow update, delete: if isSuperAdmin();

      /*
       * O proprio usuario pode excluir a propria conta.
       */
      allow delete: if isOwnUser(userId);

      // --------------------------------------------------------
      // NOTIFICACOES
      // users/{uid}/notifications/{notificationId}
      // --------------------------------------------------------

      match /notifications/{notificationId} {
        allow read, update, delete: if isOwnUser(userId);

        /*
         * Atualmente chat, Arena, convites e treinos ainda
         * criam notificacoes pelo cliente.
         *
         * Em uma etapa posterior isso sera movido ao backend.
         */
        allow create: if isAuth();
      }

      // --------------------------------------------------------
      // DADOS DE SAUDE
      // users/{uid}/medical/anamnese
      // --------------------------------------------------------

      match /medical/{medicalId} {

        /*
        * O aluno administra a propria anamnese.
        * O personal vinculado possui somente leitura.
        */
        allow read: if isOwnUser(userId)
          || isLinkedPersonal(userId);

        allow create, update, delete:
          if isOwnUser(userId);
      }

      // --------------------------------------------------------
      // AVALIACOES FISICAS
      // users/{uid}/assessments/{assessmentId}
      // --------------------------------------------------------

      match /assessments/{assessmentId} {
        allow read, create, update: if isOwnUser(userId)
          || isLinkedPersonal(userId);

        allow delete: if isOwnUser(userId)
          || isLinkedPersonal(userId);
      }
    }

    // ==========================================================
    // CONVITES PERSONAL -> ALUNO
    // ==========================================================

    match /invites/{inviteId} {

      allow read: if isAuth()
        && (
          resource.data.get('personalId', '') == authUid()
          || resource.data.get('fromPersonalId', '') == authUid()
          || resource.data.get('studentUid', '') == authUid()
          || resource.data.get('toStudentEmail', '') == authEmail()
        );

      allow create: if isPersonal()
        && exists(
          /databases/$(database)/documents/users/$(
            request.resource.data.get('studentUid', '')
          )
        )
        && get(
          /databases/$(database)/documents/users/$(
            request.resource.data.get('studentUid', '')
          )
        ).data.get('email', '')
          == request.resource.data.get('toStudentEmail', '')
        && request.resource.data.get('personalId', '') == authUid()
        && request.resource.data.get('fromPersonalId', '') == authUid()
        && request.resource.data.get('studentUid', '') != authUid()
        && request.resource.data.get('status', '') == 'pending';

      allow update: if isAuth()
        && (
          resource.data.get('studentUid', '') == authUid()
          || resource.data.get('toStudentEmail', '') == authEmail()
        )
        && resource.data.get('status', '') == 'pending'
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['status'])
        && request.resource.data.get('status', '') in [
          'accepted',
          'rejected'
        ];

      allow delete: if isAuth()
        && (
          resource.data.get('personalId', '') == authUid()
          || resource.data.get('studentUid', '') == authUid()
        );
    }

    // ==========================================================
    // FICHA SEMANAL DO ALUNO
    // workout_plans/{studentId}
    // ==========================================================

    match /workout_plans/{studentId} {
      allow read, create, update: if isOwnUser(studentId)
        || isLinkedPersonal(studentId);

      allow delete: if isLinkedPersonal(studentId);
    }

    // ==========================================================
    // HISTORICO DE TREINOS
    // ==========================================================

    match /workout_history/{historyId} {

      allow read: if isAuth()
        && (
          resource.data.get('studentId', '') == authUid()
          || isLinkedPersonal(
            resource.data.get('studentId', '')
          )
        );

      allow create: if isAuth()
        && (
          request.resource.data.get('studentId', '') == authUid()
          || isLinkedPersonal(
            request.resource.data.get('studentId', '')
          )
        );

      allow update: if isAuth()
        && (
          resource.data.get('studentId', '') == authUid()
          || isLinkedPersonal(
            resource.data.get('studentId', '')
          )
        )
        && request.resource.data.get('studentId', '')
          == resource.data.get('studentId', '');

      allow delete: if isAuth()
        && (
          resource.data.get('studentId', '') == authUid()
          || isLinkedPersonal(
            resource.data.get('studentId', '')
          )
        );
    }

    // ==========================================================
    // MODELOS PRIVADOS DO PERSONAL
    // workouts/{workoutId}
    // ==========================================================

    match /workouts/{workoutId} {

      /*
       * A tela atual ainda lista "workouts" sem filtro por
       * personalId. Mantemos leitura autenticada nesta etapa.
       */
      allow read: if isAuth();

      allow create: if isPersonal()
        && request.resource.data.get('personalId', '') == authUid();

      allow update: if isPersonal()
        && resource.data.get('personalId', '') == authUid()
        && request.resource.data.get('personalId', '') == authUid();

      allow delete: if isPersonal()
        && resource.data.get('personalId', '') == authUid();
    }

    // ==========================================================
    // LOJA / TEMPLATES
    // ==========================================================

    match /workout_templates/{templateId} {
      allow read: if isAuth();

      allow create: if isSuperAdmin()
        || (
          isPersonal()
          && request.resource.data.get('personalId', '') == authUid()
        );

      allow update: if isSuperAdmin()
        || (
          isPersonal()
          && resource.data.get('personalId', '') == authUid()
          && request.resource.data.get('personalId', '') == authUid()
        );

      allow delete: if isSuperAdmin()
        || (
          isPersonal()
          && resource.data.get('personalId', '') == authUid()
        );
    }

    // ==========================================================
    // CATALOGO GLOBAL DE EXERCICIOS
    // ==========================================================

    match /exercises/{exerciseId} {
      allow read: if isAuth();
      allow create, update, delete: if isSuperAdmin();
    }

    // ==========================================================
    // CHAT
    // ==========================================================

    match /chats/{chatId} {

      allow read: if isChatMember(chatId);

      allow create: if isAuth()
        && request.resource.data.get('users', []).size() == 2
        && request.resource.data.get('users', [])
          .hasAny([authUid()]);

      allow update: if isChatMember(chatId)
        && request.resource.data.get('users', []).size() == 2
        && request.resource.data.get('users', [])
          .hasAll(resource.data.get('users', []))
        && resource.data.get('users', [])
          .hasAll(request.resource.data.get('users', []));

      allow delete: if isChatMember(chatId);

      match /messages/{messageId} {

        /*
         * O chat atual grava a primeira mensagem antes de criar
         * o documento pai. Esta excecao preserva o comportamento
         * ate corrigirmos a arquitetura do chat.
         */
        allow read: if isAuth()
          && (
            !chatExists(chatId)
            || isChatMember(chatId)
          );

        allow create: if isAuth()
          && request.resource.data.get('senderId', '') == authUid()
          && (
            !chatExists(chatId)
            || isChatMember(chatId)
          );

        allow update, delete: if isChatMember(chatId)
          && resource.data.get('senderId', '') == authUid();
      }
    }

    // ==========================================================
    // AMIZADES - ARENA
    // ==========================================================

    match /friendships/{friendshipId} {

      allow read: if isAuth()
        && (
          resource.data.get('requesterId', '') == authUid()
          || resource.data.get('receiverId', '') == authUid()
        );

      allow create: if isAuth()
        && request.resource.data.get('requesterId', '') == authUid()
        && request.resource.data.get('receiverId', '') != authUid()
        && request.resource.data.get('status', '') == 'pending';

      allow update: if isAuth()
        && resource.data.get('receiverId', '') == authUid()
        && resource.data.get('status', '') == 'pending'
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['status'])
        && request.resource.data.get('status', '') == 'accepted';

      allow delete: if isAuth()
        && (
          resource.data.get('requesterId', '') == authUid()
          || resource.data.get('receiverId', '') == authUid()
        );
    }

    // ==========================================================
    // DUELOS - ARENA
    // ==========================================================

    match /challenges/{challengeId} {

      allow read: if isAuth()
        && resource.data.get('participantIds', [])
          .hasAny([authUid()]);

      allow create: if isAuth()
        && request.resource.data.get('creatorId', '') == authUid()
        && request.resource.data.get('participantIds', [])
          .hasAny([authUid()])
        && request.resource.data
          .get('participants', {})
          .get(authUid(), {})
          .get('status', '') == 'accepted';

      /*
      * Participante pode:
      * 1. aceitar o proprio convite;
      * 2. recusar/sair removendo apenas a si mesmo;
      * 3. marcar imagens como apagadas ao encerrar o duelo.
      */
      allow update: if isAuth()
        && resource.data.get('participantIds', [])
          .hasAny([authUid()])
        && (
          (
            request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['participants'])
            && request.resource.data.get(
              'participantIds',
              []
            ) == resource.data.get('participantIds', [])
            && request.resource.data
              .get('participants', {})
              .diff(resource.data.get('participants', {}))
              .affectedKeys().hasOnly([authUid()])
            && resource.data
              .get('participants', {})
              .get(authUid(), {})
              .get('status', '') == 'pending'
            && request.resource.data
              .get('participants', {})
              .get(authUid(), {})
              .get('status', '') == 'accepted'
            && request.resource.data
              .get('participants', {})
              .get(authUid(), {})
              .diff(
                resource.data
                  .get('participants', {})
                  .get(authUid(), {})
              )
              .affectedKeys()
              .hasOnly(['status', 'startValue'])
          )
          ||
          (
            request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['participantIds', 'participants'])
            && resource.data.get('participantIds', []).size()
              == request.resource.data
                  .get('participantIds', [])
                  .size() + 1
            && resource.data.get('participantIds', [])
              .hasAll(
                request.resource.data.get('participantIds', [])
              )
            && !request.resource.data.get('participantIds', [])
              .hasAny([authUid()])
            && request.resource.data
              .get('participants', {})
              .diff(resource.data.get('participants', {}))
              .affectedKeys().hasOnly([authUid()])
            && request.resource.data
              .get('participants', {})
              .get(authUid(), null) == null
          )
          ||
          (
            request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['imagensApagadas'])
            && resource.data.get('imagensApagadas', false) == false
            && request.resource.data.get(
              'imagensApagadas',
              false
            ) == true
          )
        );

      allow delete: if isAuth()
        && resource.data.get('creatorId', '') == authUid();

      match /posts/{postId} {

        allow read: if isChallengeParticipant(challengeId);

        allow create: if isChallengeParticipant(challengeId)
          && request.resource.data.get(
            'authorId',
            ''
          ) == authUid();

        /*
        * O app altera somente reactions ou incrementa
        * commentsCount quando um comentario e criado.
        */
        allow update: if isChallengeParticipant(challengeId)
          && (
            request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['reactions'])
            ||
            (
              request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly(['commentsCount'])
              && request.resource.data.get('commentsCount', 0)
                == resource.data.get('commentsCount', 0) + 1
            )
          );

        allow delete: if isChallengeParticipant(challengeId)
          && (
            resource.data.get('authorId', '') == authUid()
            || get(
              /databases/$(database)/documents/challenges/$(challengeId)
            ).data.get('creatorId', '') == authUid()
          );

        match /comments/{commentId} {

          allow read: if isChallengeParticipant(challengeId);

          allow create: if isChallengeParticipant(challengeId)
            && request.resource.data.get(
              'authorId',
              ''
            ) == authUid();

          allow update: if isChallengeParticipant(challengeId)
            && resource.data.get('authorId', '') == authUid()
            && request.resource.data.get(
              'authorId',
              ''
            ) == authUid();

          allow delete: if isChallengeParticipant(challengeId)
            && resource.data.get('authorId', '') == authUid();
        }
      }
    }

    // ==========================================================
    // TAREFAS PESSOAIS
    // ==========================================================

    match /tarefas/{tarefaId} {

      allow read: if isAuth()
        && resource.data.get('userId', '') == authUid();

      allow create: if isAuth()
        && request.resource.data.get('userId', '') == authUid();

      allow update: if isAuth()
        && resource.data.get('userId', '') == authUid()
        && request.resource.data.get('userId', '') == authUid();

      allow delete: if isAuth()
        && resource.data.get('userId', '') == authUid();
    }

    // ==========================================================
    // ACADEMIAS - OKAN WEB
    // ==========================================================

    match /academias/{academiaId} {
      allow read: if isAuth();

            allow create: if isAuth()
        && request.resource.data.get('ownerUid', '') == request.auth.uid
        && request.resource.data.get('emailGestor', '') == authEmail()
        && request.resource.data.get('licencasTotais', 0) == 0
        && request.resource.data.get('licencasUsadas', 0) == 0
        && !request.resource.data.keys().hasAny([
          'customerId',
          'metodoPagamentoId',
          'statusAssinatura',
          'diaVencimento',
          'cancelamentoAgendado',
          'licencasBloqueadas'
        ])
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.get('role', '') == 'gym_admin'
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.get('academiaId', '') == academiaId
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.get('email', '') == authEmail();

            // Super admin pode administrar completamente a academia.
      allow update: if isSuperAdmin();

      /*
       * O gestor pode alterar somente os dados cadastrais
       * da propria academia.
       */
      allow update: if isGymOwner(academiaId)
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'nome',
            'cnpj',
            'cep',
            'endereco',
            'bairro',
            'uf',
            'telefoneResponsavel'
          ]);

      /*
       * O painel atual controla o numero de licencas em uso
       * ao adicionar ou remover um professor.
       *
       * Limitamos a mudanca a exatamente +1 ou -1 e nunca
       * permitimos ultrapassar o total contratado ou ficar
       * abaixo de zero.
       */
      allow update: if isGymOwner(academiaId)
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['licencasUsadas'])
        && (
          request.resource.data.get('licencasUsadas', 0)
            == resource.data.get('licencasUsadas', 0) + 1
          ||
          request.resource.data.get('licencasUsadas', 0)
            == resource.data.get('licencasUsadas', 0) - 1
        )
        && request.resource.data.get('licencasUsadas', 0) >= 0
        && request.resource.data.get('licencasUsadas', 0)
          <= resource.data.get('licencasTotais', 0);

      /*
       * O gestor pode solicitar cancelamento, mas nao pode
       * reativar a assinatura diretamente pelo navegador.
       */
      allow update: if isGymOwner(academiaId)
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['cancelamentoAgendado'])
        && resource.data.get('cancelamentoAgendado', false) == false
        && request.resource.data.get(
          'cancelamentoAgendado',
          false
        ) == true;

      /*
       * Excluir a academia inteira fica restrito ao super admin.
       * O gestor possui o fluxo de cancelamento de assinatura.
       */
      allow delete: if isSuperAdmin();

      match /professores/{professorId} {
        allow read, create, update, delete: if isSuperAdmin()
          || isGymOwner(academiaId);
      }
    }

    // ==========================================================
    // FEEDBACK BETA
    // ==========================================================

    match /beta_feedback/{feedbackId} {
      allow create: if isAuth()
        && request.resource.data.get('userId', '') == authUid();

      allow read, update, delete: if isSuperAdmin();
    }

    // ==========================================================
    // FALLBACK
    // Qualquer caminho nao mapeado fica bloqueado.
    // ==========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}