rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() {
      return request.auth != null;
    }

    function validImageSize() {
      return request.resource != null
        && request.resource.size <= 10 * 1024 * 1024;
    }

    function isChallengeParticipant(challengeId) {
      return isAuth()
        && firestore.exists(
          /databases/(default)/documents/challenges/$(challengeId)
        )
        && firestore.get(
          /databases/(default)/documents/challenges/$(challengeId)
        ).data.get('participantIds', [])
          .hasAny([request.auth.uid]);
    }

    // ==========================================================
    // FOTO DE PERFIL - CAMINHO ATUAL
    // ==========================================================

    match /user_photos/{fileName} {

      // Usuarios autenticados precisam visualizar avatares.
      allow read: if isAuth();

      // Cada usuario so pode gravar a propria foto.
      allow create, update: if isAuth()
        && fileName == request.auth.uid + '.jpg'
        && validImageSize();

      allow delete: if isAuth()
        && fileName == request.auth.uid + '.jpg';
    }

    // ==========================================================
    // FOTO DE PERFIL - CAMINHO LEGADO
    // Remover apos a padronizacao do OKAN-006.
    // ==========================================================

    match /profile_photos/{fileName} {

      allow read: if isAuth();

      allow create, update: if isAuth()
        && fileName == request.auth.uid + '.jpg'
        && validImageSize();

      allow delete: if isAuth()
        && fileName == request.auth.uid + '.jpg';
    }

    // ==========================================================
    // ARENA / DUELOS
    // ==========================================================

    match /arena_duels/{challengeId}/{fileName} {

      /*
       * Apenas participantes do duelo podem visualizar/listar
       * as imagens daquele desafio.
       */
      allow read: if isChallengeParticipant(challengeId);

      /*
       * Participantes podem publicar imagens no proprio duelo.
       * Limite temporario de 10 MB por objeto.
       */
      allow create, update: if isChallengeParticipant(challengeId)
        && fileName.matches(
          '^[0-9]+_' + request.auth.uid + '[.]jpg$'
        )
        && validImageSize();

      /*
       * O app atual limpa as imagens do duelo encerrado
       * diretamente pelo cliente.
       */
      allow delete: if isChallengeParticipant(challengeId);
    }

    // ==========================================================
    // FALLBACK
    // ==========================================================

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}