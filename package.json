{
  "name": "okan-web-maintenance",
  "version": "1.0.0",
  "private": true,
  "description": "Local maintenance tools for Okan Web",
  "type": "module",
  "scripts": {
    "test": "node --test ./test/*.mjs",
    "build:staging": "node ./scripts/build-web.mjs --env staging",
    "build:staging:fixture": "node ./scripts/build-web.mjs --env staging --config ./test/fixtures/staging-web-config.json",
    "build:prod": "node ./scripts/build-web.mjs --env prod",
    "verify:staging": "node ./scripts/verify-deploy-artifact.mjs --env staging",
    "verify:prod": "node ./scripts/verify-deploy-artifact.mjs --env prod",
    "test:dashboard-a11y": "node --test ./test/dashboard_accessibility_test.mjs",
    "test:dashboard-responsive": "node --test ./test/dashboard_responsive_tables_test.mjs",
    "test:professor-details": "node --test ./test/professor_details_test.mjs",
    "test:user-model": "node --test ./test/user_model_test.mjs",
    "test:academy-licenses": "node --test ./test/academy_license_flow_test.mjs",
    "test:academy-registration": "node --test ./test/academy_registration_flow_test.mjs",
    "test:academy-billing": "node --test ./test/academy_billing_flow_test.mjs",
    "test:xss": "node --test ./test/xss_safety_test.mjs",
    "migrate:users:v2": "node ./scripts/migrate-users-v2.mjs",
    "repair:users:professor-link": "node ./scripts/repair-invalid-professor-link.mjs"
  },
  "dependencies": {
    "firebase-admin": "^14.3.0"
  }
}
