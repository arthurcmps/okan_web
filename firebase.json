{
  "hosting": [
    {
      "target": "staging",
      "public": "dist/staging",
      "predeploy": [
        "npm run verify:staging"
      ],
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ]
    },
    {
      "target": "prod",
      "public": "dist/prod",
      "predeploy": [
        "npm run verify:prod"
      ],
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ]
    }
  ],
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "okan_web",
        "supportEmail": "arthur.felipe1993@gmail.com"
      }
    }
  }
}
